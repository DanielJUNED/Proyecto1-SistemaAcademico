@model SistemaAcademico._Web.Models.ViewModels.CursoCuatrimestreDetailViewModel

@{
    ViewData["Title"] = "Detalles del Curso-Cuatrimestre";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-info-circle"></i> Detalles del Curso en Cuatrimestre
                    </h4>
                </div>
                <div class="card-body">
                    <!-- Información del Cuatrimestre -->
                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="fas fa-calendar-alt"></i> Información del Cuatrimestre
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="detail-item">
                                        <label class="text-muted">Nombre:</label>
                                        <p class="fw-bold">@Model.Cuatrimestre.Nombre</p>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="detail-item">
                                        <label class="text-muted">Año:</label>
                                        <p class="fw-bold">@Model.Cuatrimestre.Anio</p>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="detail-item">
                                        <label class="text-muted">Periodo:</label>
                                        <p class="fw-bold">@Model.Cuatrimestre.Numero° Cuatrimestre</p>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="detail-item">
                                        <label class="text-muted">Fecha Inicio:</label>
                                        <p class="fw-bold">@Model.Cuatrimestre.Fec_Inicio.ToString("dd/MM/yyyy")</p>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="detail-item">
                                        <label class="text-muted">Fecha Fin:</label>
                                        <p class="fw-bold">@Model.Cuatrimestre.Fec_Fin.ToString("dd/MM/yyyy")</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Información del Curso -->
                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="fas fa-book"></i> Información del Curso
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-2">
                                    <div class="detail-item">
                                        <label class="text-muted">Código:</label>
                                        <p class="fw-bold">@Model.Curso.Codigo</p>
                                    </div>
                                </div>
                                <div class="col-md-7">
                                    <div class="detail-item">
                                        <label class="text-muted">Nombre del Curso:</label>
                                        <p class="fw-bold">@Model.Curso.Nom_Curso</p>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="detail-item">
                                        <label class="text-muted">Créditos:</label>
                                        <p class="fw-bold">
                                            <span class="badge bg-primary fs-6">
                                                @Model.Curso.Num_Creditos créditos
                                            </span>
                                        </p>
                                    </div>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.Curso.Desc_Curso))
                            {
                                <div class="row mt-2">
                                    <div class="col-12">
                                        <div class="detail-item">
                                            <label class="text-muted">Descripción:</label>
                                            <p>@Model.Curso.Desc_Curso</p>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Docentes Asignados -->
                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="fas fa-chalkboard-teacher"></i> Docentes Asignados
                                <span class="badge bg-secondary">@Model.Docentes.Count()</span>
                            </h5>
                        </div>
                        <div class="card-body">
                            @if (Model.Docentes.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width: 5%;">#</th>
                                                <th style="width: 50%;">Nombre Completo</th>
                                                <th style="width: 45%;">Email</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                int contador = 1;
                                            }
                                            @foreach (var docente in Model.Docentes)
                                            {
                                                <tr>
                                                    <td>@contador</td>
                                                    <td>
                                                        <i class="fas fa-user-tie text-primary"></i>
                                                        @docente.NombreCompleto
                                                    </td>
                                                    <td>
                                                        <i class="fas fa-envelope text-muted"></i>
                                                        @docente.Email
                                                    </td>
                                                </tr>
                                                contador++;
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning mb-0">
                                    <i class="fas fa-exclamation-triangle"></i>
                                    No hay docentes asignados a este curso en este cuatrimestre.
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Estadísticas -->
                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="fas fa-chart-bar"></i> Estadísticas
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row text-center">
                                <div class="col-md-4">
                                    <div class="stat-card">
                                        <div class="stat-icon text-primary">
                                            <i class="fas fa-chalkboard-teacher fa-3x"></i>
                                        </div>
                                        <h3 class="mt-3">@Model.Docentes.Count()</h3>
                                        <p class="text-muted">Docentes Asignados</p>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="stat-card">
                                        <div class="stat-icon text-success">
                                            <i class="fas fa-user-graduate fa-3x"></i>
                                        </div>
                                        <h3 class="mt-3">@Model.TotalEstudiantes</h3>
                                        <p class="text-muted">Estudiantes Matriculados</p>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="stat-card">
                                        <div class="stat-icon text-info">
                                            <i class="fas fa-clipboard-check fa-3x"></i>
                                        </div>
                                        <h3 class="mt-3">
                                            @if (Model.TieneEvaluaciones)
                                            {
                                                <span class="text-success">Sí</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">No</span>
                                            }
                                        </h3>
                                        <p class="text-muted">Tiene Evaluaciones</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Botones de Acción -->
                    <div class="row">
                        <div class="col-12">
                            <a href="@Url.Action("Edit", new { id = Model.CursoCuatrimestreId })"
                               class="btn btn-warning">
                                <i class="fas fa-edit"></i> Editar
                            </a>
                            <a href="@Url.Action("Index", new { cuatrimestreId = Model.Cuatrimestre.CuatrimestreId })"
                               class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Volver al Listado
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .detail-item {
            margin-bottom: 1rem;
        }

            .detail-item label {
                display: block;
                font-size: 0.875rem;
                margin-bottom: 0.25rem;
            }

            .detail-item p {
                margin-bottom: 0;
            }

        .stat-card {
            padding: 1.5rem;
            border-radius: 0.5rem;
            background-color: #f8f9fa;
            transition: transform 0.2s;
        }

            .stat-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            }

        .stat-icon {
            opacity: 0.7;
        }
    </style>
}