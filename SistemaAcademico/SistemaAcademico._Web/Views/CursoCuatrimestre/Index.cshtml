@model SistemaAcademico._Web.Models.ViewModels.CursoCuatrimestreIndexViewModel

@{
    ViewData["Title"] = "Gestión Curso-Cuatrimestre";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-book-reader"></i> Gestión de Cursos por Cuatrimestre
                    </h4>
                </div>
                <div class="card-body">
                    <!-- Filtro por Cuatrimestre -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="filtroCuatrimestre" class="form-label">
                                <strong>Filtrar por Cuatrimestre:</strong>
                            </label>
                            <select id="filtroCuatrimestre" class="form-select">
                                <option value="">-- Todos los cuatrimestres --</option>
                                @foreach (var cuatrimestre in Model.Cuatrimestres)
                                {

                                    <option value="@cuatrimestre.CuatrimestreId"
                                            selected="@(Model.CuatrimestreIdFiltro == cuatrimestre.CuatrimestreId)">
                                        @cuatrimestre.Nombre (@cuatrimestre.Anio)
                                    </option>


                                }
                            </select>
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <button id="btnNuevo" class="btn btn-success asp-" 
                                    @(Model.CuatrimestreIdFiltro.HasValue ? "" : "disabled")>
                                <i class="fas fa-plus"></i> Nuevo Curso
                            </button>
                        </div>
                    </div>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- Tabla de Cursos -->
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="tablaCursos">
                            <thead class="table-dark">
                                <tr>
                                    <th>Código</th>
                                    <th>Curso</th>
                                    <th>Cuatrimestre</th>
                                    <th>Docentes</th>
                                    <th>Estudiantes</th>
                                    <th style="width: 200px;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.CursosCuatrimestre.Any())
                                {
                                    @foreach (var item in Model.CursosCuatrimestre)
                                    {
                                        <tr>
                                            <td>@item.CodigoCurso</td>
                                            <td>@item.NombreCurso</td>
                                            <td>@item.NombreCuatrimestre</td>
                                            <td>
                                                <span class="badge bg-info">@item.TotalDocentes</span>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">@item.TotalEstudiantes</span>
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-info" 
                                                        onclick="verDetalle(@item.CursoCuatrimestreId)">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                                <button class="btn btn-sm btn-warning" 
                                                        onclick="editar(@item.CursoCuatrimestreId)">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                @if (item.PuedeEliminar)
                                                {
                                                    <button class="btn btn-sm btn-danger" 
                                                            onclick="eliminar(@item.CursoCuatrimestreId)">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-secondary" disabled 
                                                            title="No se puede eliminar porque tiene docentes, estudiantes o evaluaciones">
                                                        <i class="fas fa-lock"></i>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center">
                                            <em>No hay cursos registrados para este cuatrimestre</em>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Cambio de filtro de cuatrimestre
            $('#filtroCuatrimestre').change(function() {
                const cuatrimestreId = $(this).val();
                if (cuatrimestreId) {
                    window.location.href = '@Url.Action("Index")?cuatrimestreId=' + cuatrimestreId;
                } else {
                    window.location.href = '@Url.Action("Index")';
                }
            });

            // Botón Nuevo
            $('#btnNuevo').click(function() {
                const cuatrimestreId = $('#filtroCuatrimestre').val();
                if (cuatrimestreId) {
                    window.location.href = '@Url.Action("Crear")?cuatrimestreId=' + cuatrimestreId;
                } else {
                    alert('Por favor, seleccione un cuatrimestre');
                }
            });
        });

        function verDetalle(id) {
            window.location.href = '@Url.Action("Detalle")/' + id;
        }

        function editar(id) {
            window.location.href = '@Url.Action("Editar")/' + id;
        }

        function eliminar(id) {
            if (confirm('¿Está seguro de eliminar este registro?')) {
                $.ajax({
                    url: '@Url.Action("Eliminar")/' + id,
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            alert(response.message);
                            location.reload();
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function(xhr) {
                        const error = xhr.responseJSON?.message || 'Error al eliminar';
                        alert(error);
                    }
                });
            }
        }
    </script>
}