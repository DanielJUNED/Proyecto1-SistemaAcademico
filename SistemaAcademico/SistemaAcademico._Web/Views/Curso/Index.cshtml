@model List<SistemaAcademico._Web.Models.ViewModels.CursoListViewModel>

@{
    ViewBag.Title = "Gestión de Cursos";
}

<div class="container mt-4">
    <h2>Gestión de Cursos</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error:</strong> @ViewBag.Error
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Éxito:</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="mb-3">
        <a href="@Url.Action("Crear", "Curso")" class="btn btn-primary">
            <i class="fa fa-plus"></i> Crear Nuevo Curso
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <table id="tablaCursos" class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Código</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Créditos</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var curso in Model)
                        {
                            <tr>
                                <td>@curso.Codigo</td>
                                <td>@curso.Nombre</td>
                                <td>@(string.IsNullOrEmpty(curso.Descripcion) ? "N/A" : curso.Descripcion)</td>
                                <td>@curso.Descripcion</td>
                                <td>
                                    <a href="@Url.Action("Editar", "Curso", new { id = curso.CursoId })"
                                       class="btn btn-sm btn-warning" title="Editar">
                                        <i class="fa fa-edit"></i> Editar
                                    </a>
                                    <button type="button"
                                            class="btn btn-sm btn-danger btnEliminar"
                                            data-id="@curso.CursoId"
                                            data-nombre="@curso.Nombre"
                                            title="Eliminar">
                                        <i class="fa fa-trash"></i> Eliminar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fa fa-info-circle"></i> No hay cursos registrados.
                    <a href="@Url.Action("Crear", "Curso")">Crear el primer curso</a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var eliminarUrlBase = '@Url.Action("Eliminar", "Curso")';
    </script>
    <script src="~/js/cursos/index.js"></script>
    <script>
        $(document).ready(function() {
            // Inicializar DataTable si existe
            @if (Model != null && Model.Any())
            {
                    <text>
                    $('#tablaCursos').DataTable({
                        language: {
                            url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
                        },
                        responsive: true,
                        order: [[0, 'asc']]
                    });
                    </text>
            } 
        });
    </script>
}