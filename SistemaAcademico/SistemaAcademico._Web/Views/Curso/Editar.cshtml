@model SistemaAcademico._Web.Models.ViewModels.CursoFormViewModel
@{
    ViewBag.Title = "Editar Curso";
}

<div class="container mt-4">
    <h2>Editar Curso</h2>

    <div class="card">
        <div class="card-body">
            <form id="formCurso">
                <input type="hidden" id="cursoId" value="@Model.CursoId"> 
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label>Código</label>
                    <input type="text" class="form-control" id="codigo" value="@Model.Codigo" readonly>
                </div>

                <div class="form-group">
                    <label>Nombre del Curso</label>
                    <input type="text" class="form-control" id="nombre" value="@Model.Nombre" required>
                </div>

                <div class="form-group">
                    <label>Descripción</label>
                    <textarea class="form-control" id="descripcion" rows="3">@Model.Descripcion</textarea>
                </div>

                <div class="form-group">
                    <label>Créditos</label>
                    <input type="number" class="form-control" id="creditos" min="1" max="5" value="@Model.Creditos" required>
                </div>

                <button type="submit" class="btn btn-primary">Actualizar</button>
                <a href="@Url.Action("Index", "Curso")" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function () {

        $('#formCurso').on('submit', function (e) {
            e.preventDefault();

            const cursoId = $('#cursoId').val();

            const curso = {
                CursoId: cursoId,
                Codigo: $('#codigo').val(),
                Nom_Curso: $('#nombre').val(),
                Desc_Curso: $('#descripcion').val(),
                Num_Creditos: parseInt($('#creditos').val())
            };

            $.ajax({
                url: '/api/cursos/' + cursoId,
                type: 'PUT',
                contentType: 'application/json',
                data: JSON.stringify(curso),
                success: function (response) {
                    alert('Curso actualizado correctamente');
                    window.location.href = '/Curso/Index';
                },
                error: function () {
                    alert('Error al actualizar el curso');
                }
            });
        });
    });
</script>
}  