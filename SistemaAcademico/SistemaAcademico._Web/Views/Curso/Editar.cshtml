@model SistemaAcademico._Web.Models.ViewModels.CursoFormViewModel
@{
    ViewBag.Title = "Editar Curso";
}

<div class="container mt-4">
    <h2>Editar Curso</h2>

    <div class="card">
        <div class="card-body">
            <form id="formCurso"> 
                <input type="hidden" name="CursoId" value="@Model.CursoId" />

                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label>Código</label>
                    <input type="text" id="codigo" name="Codigo" class="form-control" value="@Model.Codigo" readonly>
                </div>

                <div class="form-group">
                    <label>Nombre del Curso</label>
                    <input type="text" id="nombre" name="Nombre" class="form-control" value="@Model.Nombre">
                </div>

                <div class="form-group">
                    <label>Descripción</label>
                    <textarea id="descripcion" name="Descripcion" class="form-control">@Model.Descripcion</textarea>
                </div>

                <div class="form-group">
                    <input type="number" id="creditos" name="Creditos" class="form-control" value="@Model.Creditos">
                </div>

                <button type="submit" class="btn btn-primary">Actualizar</button>
                <a href="@Url.Action("Index", "Curso")" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function () {
        $('#formCurso').on('submit', function (e) {
            e.preventDefault();

            $.ajax({
                url: '@Url.Action("Editar", "Curso", new { id = Model.CursoId })',
                type: 'POST',
                data: $('#formCurso').serialize(),
                success: function () {
                    alert('Curso actualizado correctamente');
                    window.location.href = '/Curso/Index';
                },
                error: function (xhr) {
                    console.log(xhr);
                    alert('Error al actualizar el curso');
                }
            });

        }); 

    });
</script>
}  