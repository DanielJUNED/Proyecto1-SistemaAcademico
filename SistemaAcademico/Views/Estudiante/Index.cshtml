@model IEnumerable<SistemaAcademico.Models.Estudiante>

@{
    ViewBag.Title = "Lista Estudiante";
}

<h2>Lista Estudiante</h2>

<p>
    @Html.ActionLink("Crear Estudiente", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.EstudianteId)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Nombre)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Apellidos)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Identificacion)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Fec_Nacimiento)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Email)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Ind_Estado)
        </th> 
        <th>
            @Html.DisplayNameFor(model => model.Distrito.Nom_Distrito)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.EstudianteId)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Nombre)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Apellidos)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Identificacion)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Fec_Nacimiento)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Email)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Ind_Estado)
        </td> 
        <td>
            @Html.DisplayFor(modelItem => item.Distrito.Nom_Distrito)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id = item.EstudianteId }) |
            @Html.ActionLink("Details", "Details", new { id = item.EstudianteId }) |
            @Html.ActionLink("Delete", "Delete", new { id = item.EstudianteId })
        </td>
    </tr>
}

</table>
